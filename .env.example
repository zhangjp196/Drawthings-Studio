# ---- 数据目录 ----
# 数据库(app.db)、媒体文件、项目元数据均存放于此。
# DATA_DIR=./data

# ---- 服务监听（服务模式 / CS 桌面客户端）----
# 默认仅绑本机回环，不对外；局域网访问需显式设 HOST=0.0.0.0。
# HOST=127.0.0.1
# PORT=8010
# RELOAD=0        # 开发热重载设为 1（CS 客户端拉起服务时固定 0）
# LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# 说明：本文件（.env）在启动时自动加载（不覆盖已存在的环境变量）；
# 项目根 / 当前工作目录 / 应用支持目录下的 .env 均可。
# LLM / DrawThings 的端点、模型、API Key 等配置已迁移到页面管理
# （/configs），按项目选用并存储于 SQLite，不再使用配置文件。
# 本应用直接调用真实服务（OpenAI 协议 LLM + Draw Things gRPC），
# 运行前请先启动对应端点（见 README.zh-CN.md「运行前提」）。
